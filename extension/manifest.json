{
  "manifest_version": 3,
  "name": "TypeU",
  "version": "1.0",
  "description": "C++ predictive typing compiled to WebAssembly. Why should phones get all the fun?",
  "permissions": ["storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}